        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_company_id: $('¿Hay a quién avisar?').item.json.company_id, p_system: 'sales', p_name: 'Recordatorio al vendedor', p_status: 'ok', p_detail: $('¿Hay a quién avisar?').item.json.cantidad + ' sin atender · ' + $('¿Hay a quién avisar?').item.json.vendedor }) }}",
        "options": {}
      },
