    {
      "parameters": {
        "sendTo": "={{ $json.para }}",
        "subject": "=[{{ $json.empresa }}] {{ $json.cantidad === 1 ? 'Tienes 1 prospecto sin atender' : 'Tienes ' + $json.cantidad + ' prospectos sin atender' }}",
        "emailType": "text",
        "message": "=Hola, {{ $json.vendedor }}:\n\nEstos prospectos siguen en estado \"Nuevo\" y esperan respuesta:\n\n{{ $json.detalle }}\n\nCuando los contactes, cambia su estado en el panel y dejarás de recibir este aviso:\nhttps://brich-platform.vercel.app/portal/prospectos?estado=nuevo",
        "options": {
          "appendAttribution": false,
          "ccList": "={{ $json.copia || '' }}"
        }
      },
      "id": "4e5f6071-8293-4a4b-9c5d-6e7f8091a2b4",
      "name": "Enviar recordatorio",
